{
  "name": "prohori",
  "version": "1.0.0",
  "private": true,
  "description": "Prohori - AgentOps Control Plane",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/tools/*"
  ],
 "scripts": {
  "dev": "concurrently -n API,WEB -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
  "build": "npm run build --workspaces --if-present",
  "lint": "eslint .",
  "test": "vitest run",
  "test:watch": "vitest",
  "format": "prettier --write .",
  "format:check": "prettier --check ."
},
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
